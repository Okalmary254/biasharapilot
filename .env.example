# Neon Auth URL (Managed Better Auth)
VITE_NEON_AUTH_URL=your_neon_auth_url

# Neon Data API URL (database queries; separate from Auth)
VITE_NEON_DATA_API_URL=your_neon_data_api_url

# Legacy Auth URL fallback. Prefer VITE_NEON_AUTH_URL.
# VITE_NEON_URL=your_neon_auth_url

# AI endpoint. Leave blank to use the same-origin Vercel function at /api/ai.
VITE_AI_API_URL=

# Server-only secrets/configuration. Do NOT prefix these with VITE_.
# Set these in Vercel Project Settings > Environment Variables.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
NEON_DATA_API_URL=your_neon_data_api_url
# Optional comma-separated extra browser/WebView origins for cross-origin APK/API deployments.
APP_ORIGINS=capacitor://localhost,http://localhost,https://localhost,http://localhost:5173,http://localhost:3000
