# Neon Data API base URL (no database password or credentials)
VITE_NEON_URL=your_neon_https_base_url

# AI endpoint. Leave blank to use the same-origin Vercel function at /api/ai.
VITE_AI_API_URL=

# Server-only secrets/configuration. Do NOT prefix these with VITE_.
# Set these in Vercel Project Settings > Environment Variables.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
NEON_DATA_API_URL=your_neon_data_api_base_url
